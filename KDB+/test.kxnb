{"cells":[{"kind":2,"value":"/ ── 2. Fetch and Clean via Python Pandas ─────────────────────\np)import pandas as pd\np)from achest import MarketDataClient\np)client = MarketDataClient(\"https://achestv2.misango.me\")\np)raw = client.get([\"BTCUSDT\"], \"2026-09-01\", \"2026-09-23\", \"minute\")\np)client.close()\np)df = pd.DataFrame(raw)\np)df['time'] = pd.to_datetime(df['timestamp']).dt.date\np)df['open'] = df['open'].astype(float)\np)df['high'] = df['high'].astype(float)\np)df['low'] = df['low'].astype(float)\np)df['close'] = df['close'].astype(float)\np)df['volume'] = df['volume'].astype(float)\np)df = df.drop(columns=['timestamp'])","languageId":"q","outputs":[{"items":[{"data":"","mime":"text/plain"}]}]},{"kind":2,"value":"p)print(df.head(4))","languageId":"q","outputs":[{"items":[{"data":"    symbol provider      open  ...     close    volume        time\r\n0  BTCUSDT  binance  78581.30  ...  78562.00   8.67833  2026-09-01\r\n1  BTCUSDT  binance  78562.01  ...  78581.98   5.68958  2026-09-01\r\n2  BTCUSDT  binance  78581.99  ...  78607.99   8.83762  2026-09-01\r\n3  BTCUSDT  binance  78608.00  ...  78625.99  10.43244  2026-09-01\r\n[4 rows x 8 columns]\r\n","mime":"text/plain"}]}]},{"kind":2,"value":"/ This bypasses the evaluation wrapper error completely\ntbl: .pykx.toq .pykx.get `raw\n\n/ ── 3. Clean up the types without using backslashes ─────────\ntbl: update\n  time:   \"D\"$string timestamp,\n  open:   \"F\"$string open,\n  high:   \"F\"$string high,\n  low:    \"F\"$string low,\n  close:  \"F\"$string close,\n  volume: \"J\"$string volume\n  from tbl\n\n/ Sort and apply attribute for downstream asof joins (aj)\ntbl: `time xasc tbl\ntbl: update `g#symbol from tbl\n\n/ ── 4. Verify types and split ────────────────────────────────\nmeta tbl\naapl: select from tbl where symbol = `AAPL\n\n/ ── 5. Run your moving average ───────────────────────────────\naapl_ma: select time, close, ma2: mavg[2;close], ma5: mavg[5;close] from aapl\n\n","languageId":"q","outputs":[{"items":[{"data":"c        | t f a\r\n---------| -----\r\ntimestamp| s    \r\nsymbol   | s   g\r\nprovider | s    \r\nopen     | f    \r\nhigh     | f    \r\nlow      | f    \r\nclose    | f    \r\nvolume   | j    \r\ntime     | d   s\r\n","mime":"text/plain"}]}]},{"kind":2,"value":"aapl_ma","languageId":"q","outputs":[{"items":[{"data":"time       close  ma2     ma5     \r\n----------------------------------\r\n0000.00.00 325.13 325.13  325.13  \r\n0000.00.00 324.96 325.045 325.045 \r\n0000.00.00 328.21 326.585 326.1   \r\n0000.00.00 319.97 324.09  324.5675\r\n0000.00.00 316.22 318.095 322.898 \r\n0000.00.00 315.34 315.78  320.94  \r\n0000.00.00 326.57 320.955 321.262 \r\n0000.00.00 332.27 329.42  322.074 \r\n0000.00.00 333.08 332.675 324.696 \r\n0000.00.00 331.34 332.21  327.72  \r\n0000.00.00 332.41 331.875 331.134 \r\n0000.00.00 337    334.705 333.22  \r\n0000.00.00 336.13 336.565 333.992 \r\n0000.00.00 338.98 337.555 335.172 \r\n","mime":"text/plain"}]}]}]}